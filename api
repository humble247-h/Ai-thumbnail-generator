import os
import json
from http.server import BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs
import openai

# Initialize OpenAI API key
openai.api_key = os.environ.get('OPENAI_API_KEY')

class handler(BaseHTTPRequestHandler):
    def do_GET(self):
        try:
            # Parse query parameters
            parsed_url = urlparse(self.path)
            query_params = parse_qs(parsed_url.query)
            topic = query_params.get('topic', [''])[0]

            if not topic:
                self.send_response(400)
                self.send_header('Content-type', 'application/json')
                self.end_headers()
                response = {"error": "Please provide a 'topic' parameter"}
                self.wfile.write(json.dumps(response).encode())
                return

            # Generate title using OpenAI
            title_response = openai.ChatCompletion.create(
                model="gpt-3.5-turbo",
                messages=[
                    {
                        "role": "system",
                        "content": "You are a YouTube content expert. Generate compelling, SEO-optimized video titles that are attention-grabbing and under 60 characters."
                    },
                    {
                        "role": "user",
                        "content": f"Generate a YouTube video title for this topic: {topic}"
                    }
                ],
                temperature=0.7,
                max_tokens=100
            )

            title = title_response.choices[0].message.content.strip()

            # Generate thumbnail description
            thumbnail_response = openai.ChatCompletion.create(
                model="gpt-3.5-turbo",
                messages=[
                    {
                        "role": "system",
                        "content": "You are a thumbnail design expert. Provide a detailed description for creating a visually appealing YouTube thumbnail."
                    },
                    {
                        "role": "user",
                        "content": f"Generate a thumbnail design description for a YouTube video about: {topic}"
                    }
                ],
                temperature=0.7,
                max_tokens=200
            )

            thumbnail_description = thumbnail_response.choices[0].message.content.strip()

            self.send_response(200)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            response = {
                "topic": topic,
                "title": title,
                "thumbnail_description": thumbnail_description,
                "success": True
            }
            self.wfile.write(json.dumps(response).encode())

        except Exception as e:
            self.send_response(500)
            self.send_header('Content-type', 'application/json')
            self.end_headers()
            response = {"error": str(e)}
            self.wfile.write(json.dumps(response).encode())
